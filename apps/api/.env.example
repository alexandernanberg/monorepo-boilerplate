# Copy to `.env` and adjust. Bun loads `.env` (and `.env.local`, which wins)
# automatically, so nothing has to be exported by hand.
#
# The values below are the development defaults from `src/config.ts` and match
# the `docker-compose.yml` stack — in development every variable here is
# optional. In production the ones marked REQUIRED have no default and the
# process refuses to boot without them. The test environment ignores this file
# entirely and talks to `docker-compose.test.yml`.

# HTTP port the server listens on.
PORT=4000

# REQUIRED in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workout

# Address transactional mail is sent from. REQUIRED in production.
EMAIL_SENDER=noreply@acme.inc

# SMTP transport. Points at the local Mailpit container; in production
# SMTP_HOST, SMTP_USER and SMTP_PASSWORD are REQUIRED, and the defaults become
# port 587 with TLS on.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

# REDIS_HOST and REDIS_PASSWORD are REQUIRED in production. REDIS_USER is only
# needed for a Redis 6+ ACL user other than the default one.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=

# Sessions. A session is renewed once it is inside the second half of its TTL,
# and `lastActiveAt` is written at most once per threshold.
SESSION_TTL_DAYS=30
SESSION_LAST_ACTIVE_THRESHOLD_MINUTES=10

# Signup and login codes, and how many wrong guesses a code survives.
SIGNUP_CODE_TTL_MINUTES=15
LOGIN_CODE_TTL_MINUTES=15
MAX_FAILED_SIGNUP_ATTEMPTS=3
MAX_FAILED_EMAIL_LOGIN_ATTEMPTS=3

# Per-IP token bucket in front of the auth routes.
RATE_LIMIT_IP_BUCKET_SIZE=10
RATE_LIMIT_IP_BUCKET_REFILL_RATE_SECONDS=1

# How long in-flight work gets to finish after a SIGTERM. Keep it below the
# platform's own grace period, or SIGKILL ends the process mid-drain.
SHUTDOWN_TIMEOUT_SECONDS=10
