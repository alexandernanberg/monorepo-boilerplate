# Copy to .env and fill in. Development works with none of this set — every
# value below is the default. Production requires the ones marked REQUIRED and
# refuses to boot without them.

# NODE_ENV=development
# PORT=4000

# REQUIRED in production
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/workout

# REQUIRED in production
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USER=
# REDIS_PASSWORD=

# REQUIRED in production
# EMAIL_SENDER=noreply@acme.inc
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=false

# Only enable behind a proxy that overwrites the forwarded headers. Exposed
# directly, they are client-controlled and rate limits become unenforceable.
# TRUST_PROXY=false

# Comma-separated. No CORS headers are emitted when empty.
# CORS_ORIGINS=

# MAX_REQUEST_BODY_BYTES=65536
# GRAPHIQL_ENABLED=true
# GRAPHQL_MAX_DEPTH=12

# SESSION_TTL_DAYS=30
# SESSION_LAST_ACTIVE_THRESHOLD_MINUTES=10
# SIGNUP_CODE_TTL_MINUTES=15
# LOGIN_CODE_TTL_MINUTES=15
# MAX_FAILED_SIGNUP_ATTEMPTS=3
# MAX_FAILED_EMAIL_LOGIN_ATTEMPTS=3

# RATE_LIMIT_IP_BUCKET_SIZE=10
# RATE_LIMIT_IP_BUCKET_REFILL_RATE_SECONDS=1

# 0 disables the sweeper.
# CLEANUP_INTERVAL_MINUTES=60

# Migrate during boot instead of as a release command. Single-instance only.
# MIGRATE_ON_START=false

# Must stay below the platform's own grace period.
# SHUTDOWN_TIMEOUT_SECONDS=10
