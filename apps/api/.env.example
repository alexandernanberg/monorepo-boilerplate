# Local defaults match docker compose. Development Config already uses these
# if the variable is unset — copy to apps/api/.env only to override. Bun reads
# .env from the working directory, which is apps/api, not the repo root.
NODE_ENV=development

DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
REDIS_HOST=localhost
REDIS_PORT=6379

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=false

# Production (NODE_ENV=production) also requires:
# BETTER_AUTH_SECRET=   # 32+ characters
# BETTER_AUTH_URL=https://api.example.com
# APP_ORIGIN=https://app.example.com
# DATABASE_URL=postgres://user:password@host:5432/app
# REDIS_URL=rediss://user:password@host:6379
# EMAIL_SENDER=noreply@example.com
# SMTP_HOST=email-smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=true        # default in production; set false to allow plaintext
# SMTP_USER=
# SMTP_PASSWORD=
# Proxies in front of the API whose x-forwarded-for entries are trusted
# (comma-separated IPs/CIDRs). Leave unset when clients connect directly.
# TRUSTED_PROXIES=10.0.0.0/8
