{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun dist/server.js",
    "test": "bun test --preload ./src/__tests__/setup-tests.ts",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run src/db/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@pothos/core": "^4.5.0",
    "@pothos/plugin-dataloader": "^4.3.0",
    "@pothos/plugin-relay": "^4.4.0",
    "@pothos/plugin-tracing": "^1.1.0",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.0",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.2",
    "graphql-yoga": "^5.13.2",
    "hono": "^4.11.7",
    "ioredis": "^5.6.0",
    "ms": "^2.1.3",
    "nodemailer": "^6.10.0",
    "pg": "^8.14.1",
    "slugify": "^1.6.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.6.0",
    "@types/ms": "^2.1.0",
    "@types/node": "22.13.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "bun-types": "^1.2.5",
    "drizzle-kit": "^0.30.5",
    "eslint": "catalog:",
    "eslint-config-alexandernanberg": "^4.0.2",
    "eslint-plugin-drizzle": "^0.2.3",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
