{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server.ts",
    "build": "bun build src/server.ts --target bun --outdir ./dist",
    "start": "NODE_ENV=production bun dist/server.js",
    "test": "NODE_ENV=test bun test --preload ./src/__tests__/setup-tests.ts",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "bun src/db/migrate.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.2",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pothos/core": "^4.13.1",
    "@pothos/plugin-relay": "^4.7.1",
    "better-auth": "1.7.2",
    "dataloader": "^2.2.3",
    "drizzle-orm": "^0.45.2",
    "evlog": "^2.27.1",
    "graphql": "^17.0.2",
    "graphql-scalars": "^2.0.0",
    "graphql-yoga": "^5.22.0",
    "hono": "^4.13.5",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.6",
    "pg": "^8.23.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "oxlint": "catalog:",
    "oxlint-config-alexandernanberg": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
