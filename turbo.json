{
  "$schema": "https://turborepo.org/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".cache/tsbuildinfo.json", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      // Strict env mode would drop anything exported in the shell (e.g.
      // `DATABASE_URL=… pnpm dev`). Uncached, so nothing to invalidate.
      "passThroughEnv": ["*"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false,
      // e.g. DOCKER_HOST for the compose stack the tests start.
      "passThroughEnv": ["*"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
